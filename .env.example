# ════════════════════════════════════════════
# VIPLINE TECHNOLOGIES - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values
# ════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=production

# Your live Railway URL (set this after first deploy)
# Example: https://viplinetech.up.railway.app
SITE_URL=https://your-app-name.up.railway.app

# Session secret - change this to any long random string
SESSION_SECRET=viplinetech_change_this_to_something_random_2026
